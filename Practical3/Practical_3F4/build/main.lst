 271:Core/Src/main.c **** uint64_t calculate_mandelbrot_double(int width, int height, int max_iterations){
 272:Core/Src/main.c ****   uint64_t mandelbrot_sum = 0;
 273:Core/Src/main.c ****     for (int y=0; y<height; y++) {
 274:Core/Src/main.c ****       for (int x=0; x<width; x++) {
 275:Core/Src/main.c ****     	  double x0 = 3.5*x/width-2.5;
 276:Core/Src/main.c ****     	  double y0 = 2.0*y/height-1.0;
 277:Core/Src/main.c ****     	  double xi = 0;
 278:Core/Src/main.c ****     	  double yi = 0;
 279:Core/Src/main.c ****     	  int iteration = 0;
 280:Core/Src/main.c ****     	  while (iteration<max_iterations && (xi*xi+yi*yi)<=4) {
 281:Core/Src/main.c ****     		  double temp = xi*xi-yi*yi;
 282:Core/Src/main.c ****     		  yi = 2*xi*yi+y0;
 283:Core/Src/main.c ****     		  xi = temp+x0;
 284:Core/Src/main.c ****     		  iteration++;
ARM GAS  C:\Users\techn\AppData\Local\Temp\ccHRxhyC.s 			page 9


 285:Core/Src/main.c ****     	  }
 286:Core/Src/main.c ****     	  mandelbrot_sum += iteration;
 287:Core/Src/main.c ****       }
 288:Core/Src/main.c ****     }
 289:Core/Src/main.c **** 
 290:Core/Src/main.c ****     return mandelbrot_sum;
 291:Core/Src/main.c **** }
