 242:Core/Src/main.c **** uint64_t calculate_mandelbrot_fixed_point_arithmetic(int width, int height, int max_iterations){
 243:Core/Src/main.c ****   uint64_t mandelbrot_sum = 0;
 244:Core/Src/main.c ****     int64_t s = (1<<20); //scaling factor
 245:Core/Src/main.c **** 
 246:Core/Src/main.c ****     int64_t x_scale = 3.5*s;
 247:Core/Src/main.c ****     int64_t x_shift = 2.5*s;
 248:Core/Src/main.c ****     int64_t y_scale = 2.0*s;
 249:Core/Src/main.c ****     int64_t y_shift = 1.0*s;
 250:Core/Src/main.c **** 
 251:Core/Src/main.c ****     for (int y=0; y<height; y++) {
 252:Core/Src/main.c ****     	for (int x=0; x<width; x++) {
 253:Core/Src/main.c ****     		int64_t x0 = (x_scale*x)/width-x_shift;
 254:Core/Src/main.c ****     		int64_t y0 = (y_scale*y)/height-y_shift;
 255:Core/Src/main.c ****     		int64_t xi = 0;
 256:Core/Src/main.c ****     		int64_t yi = 0;
 257:Core/Src/main.c ****     		int iteration = 0;
 258:Core/Src/main.c ****     		while (iteration<max_iterations && (xi*xi+yi*yi)/s<=(4*s)) {
 259:Core/Src/main.c ****     			int64_t temp = (xi*xi-yi*yi)/s;
 260:Core/Src/main.c ****     			yi = 2*xi*yi/s+y0;
 261:Core/Src/main.c ****     			xi = temp+x0;
 262:Core/Src/main.c ****     			iteration++;
 263:Core/Src/main.c ****     		}
 264:Core/Src/main.c ****     		mandelbrot_sum += iteration;
 265:Core/Src/main.c ****     	}
 266:Core/Src/main.c ****     }
 267:Core/Src/main.c **** 
 268:Core/Src/main.c ****     return mandelbrot_sum;
 269:Core/Src/main.c **** }
