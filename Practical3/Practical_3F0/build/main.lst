 241:Core/Src/main.c **** uint64_t calculate_mandelbrot_fixed_point_arithmetic(int width, int height, int max_iterations){
 242:Core/Src/main.c ****   uint64_t mandelbrot_sum = 0;
 243:Core/Src/main.c ****     int64_t s = (1<<20); //scaling factor
 244:Core/Src/main.c **** 
 245:Core/Src/main.c ****     int64_t x_scale = 3.5*s;
 246:Core/Src/main.c ****     int64_t x_shift = 2.5*s;
 247:Core/Src/main.c ****     int64_t y_scale = 2.0*s;
 248:Core/Src/main.c ****     int64_t y_shift = 1.0*s;
 249:Core/Src/main.c **** 
 250:Core/Src/main.c ****     for (int y=0; y<height; y++) {
 251:Core/Src/main.c ****     	for (int x=0; x<width; x++) {
 252:Core/Src/main.c ****     		int64_t x0 = (x_scale*x)/width-x_shift;
 253:Core/Src/main.c ****     		int64_t y0 = (y_scale*y)/height-y_shift;
 254:Core/Src/main.c ****     		int64_t xi = 0;
 255:Core/Src/main.c ****     		int64_t yi = 0;
 256:Core/Src/main.c ****     		int iteration = 0;
 257:Core/Src/main.c ****     		while (iteration<max_iterations && (xi*xi+yi*yi)/s<=(4*s)) {
 258:Core/Src/main.c ****     			int64_t temp = (xi*xi-yi*yi)/s;
 259:Core/Src/main.c ****     			yi = 2*xi*yi/s+y0;
 260:Core/Src/main.c ****     			xi = temp+x0;
 261:Core/Src/main.c ****     			iteration++;
 262:Core/Src/main.c ****     		}
 263:Core/Src/main.c ****     		mandelbrot_sum += iteration;
 264:Core/Src/main.c ****     	}
 265:Core/Src/main.c ****     }
 266:Core/Src/main.c **** 
 267:Core/Src/main.c ****     return mandelbrot_sum;
 268:Core/Src/main.c **** }
 269:Core/Src/main.c **** 
 270:Core/Src/main.c **** uint64_t calculate_mandelbrot_double(int width, int height, int max_iterations){
 271:Core/Src/main.c ****   uint64_t mandelbrot_sum = 0;
 272:Core/Src/main.c ****     for (int y=0; y<height; y++) {
 273:Core/Src/main.c ****       for (int x=0; x<width; x++) {
 274:Core/Src/main.c ****     	  double x0 = 3.5*x/width-2.5;
 275:Core/Src/main.c ****     	  double y0 = 2.0*y/height-1.0;
 276:Core/Src/main.c ****     	  double xi = 0;
 277:Core/Src/main.c ****     	  double yi = 0;
 278:Core/Src/main.c ****     	  int iteration = 0;
 279:Core/Src/main.c ****     	  while (iteration<max_iterations && (xi*xi+yi*yi)<=4) {
 280:Core/Src/main.c ****     		  double temp = xi*xi-yi*yi;
 281:Core/Src/main.c ****     		  yi = 2*xi*yi+y0;
 282:Core/Src/main.c ****     		  xi = temp+x0;
 283:Core/Src/main.c ****     		  iteration++;
 284:Core/Src/main.c ****     	  }
 285:Core/Src/main.c ****     	  mandelbrot_sum += iteration;
 286:Core/Src/main.c ****       }
 287:Core/Src/main.c ****     }
 288:Core/Src/main.c **** 
 289:Core/Src/main.c ****     return mandelbrot_sum;
 290:Core/Src/main.c **** }
